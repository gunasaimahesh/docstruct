# DocStruct Configuration
# Copy this file to .env.local and fill in your values

# --- LLM provider (pick ONE option) ---

# Option A (recommended, generous free tier ~1500 requests/day, no credit card):
# Google AI Studio - get a key at https://aistudio.google.com/apikey
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
# Gemini 3.x thinking shares max_tokens with the answer — use low/none for JSON extraction
LLM_REASONING_EFFORT=none
# Large extractions (résumés with nested evidence) need more than 8192 completion tokens
LLM_MAX_TOKENS=24576

# Option B: OpenRouter (default if LLM_* vars above are unset)
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: cap on max_tokens per LLM request (default 8192).
# Lower for Groq free tier (12k TPM counts input + max_tokens) — use 4096.
# Also useful if OpenRouter rejects with a 402 "requires more credits".
# LLM_MAX_TOKENS=4096

# Optional: database connection (defaults shown)
# DB_URL=jdbc:postgresql://localhost:5432/docstruct
# DB_USERNAME=docstruct
# DB_PASSWORD=docstruct

# Optional: backend URL for the frontend proxy (dev + Docker/Railway build)
# API_URL=http://localhost:8080

# Optional: comma-separated origins allowed to call the API directly
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Railway / production ---
# Backend listens on PORT (injected by Railway; local default 8080).
# PORT=8080
#
# Backend service variables (use Railway variable references for Postgres):
#   DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#   DB_USERNAME=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}
#   CORS_ALLOWED_ORIGINS=https://<frontend-public-domain>
#   LLM_API_KEY / LLM_BASE_URL / LLM_MODEL  (same as local)
#
# Frontend service variables (required at Docker build time for /api rewrites):
#   API_URL=https://<backend-public-domain>
